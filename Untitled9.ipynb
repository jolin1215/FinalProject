    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Read the Excel file\n",
        "data = pd.read_excel('活頁簿1.xlsx')\n",
        "\n",
        "# Define a function to assign each study time to a corresponding range\n",
        "def assign_time_range(time):\n",
        "    if time < 5:\n",
        "        return '3hr'\n",
        "    elif time == 5:\n",
        "        return '5hr'\n",
        "    elif time == 10:\n",
        "        return '10hr'\n",
        "    else:\n",
        "        return '15~hr'\n",
        "\n",
        "# Add the study time range column\n",
        "data['Study Time Range'] = data['Weekly Study Time'].apply(assign_time_range)\n",
        "\n",
        "# Group by study time range and biological sex, and count people in each range\n",
        "grouped_data = data.groupby(['Study Time Range', 'Biological Sex']).size().unstack().fillna(0)\n",
        "\n",
        "# Define a custom x-axis order\n",
        "custom_order = ['3hr', '5hr', '10hr', '15~hr']\n",
        "\n",
        "# Draw a line chart\n",
        "grouped_data.plot(kind='line')\n",
        "\n",
        "# Set the x-axis ticks in order\n",
        "plt.xticks(range(len(custom_order)), custom_order)\n",
        "\n",
        "# Set chart labels\n",
        "plt.xlabel('Time Range')\n",
        "plt.ylabel('Number of people')\n",
        "\n",
        "# Show the chart\n",
        "plt.show()\n"
      ],
