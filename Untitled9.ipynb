      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Read the Excel file\n",
        "data = pd.read_excel('活頁簿1.xlsx')\n",
        "\n",
        "# Define a function to assign each study time to a corresponding range\n",
        "def assign_time_range(time):\n",
        "    if time < 5:\n",
        "        return '3hr'\n",
        "    elif time == 5:\n",
        "        return '5hr'\n",
        "    elif time == 10:\n",
        "        return '10hr'\n",
        "    else:\n",
        "        return '15~hr'\n",
        "\n",
        "# Add the study time range column\n",
        "data['Study Time Range'] = data['Weekly Study Time'].apply(assign_time_range)\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Set the category order for study time ranges\n",
        "time_order = ['3hr', '5hr', '10hr', '15~hr']\n",
        "data['Study Time Range'] = pd.Categorical(data['Study Time Range'], categories=time_order, ordered=True)\n",
        "\n",
        "# Group by college and study time range, then count people\n",
        "grouped_data = data.groupby(['College', 'Study Time Range']).size().reset_index(name='People')"
      ],
      "metadata": {
        "id": "3ZhWlQdr-GTD"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Set chart style\n",
        "plt.style.use('seaborn')\n",
        "\n",
        "# Convert data into a format suitable for a stacked bar chart\n",
        "pivot_data = grouped_data.pivot(index='College', columns='Study Time Range', values='People')\n",
        "\n",
        "# Draw stacked bar chart\n",
        "pivot_data.plot(kind='bar', stacked=True)\n",
        "\n",
        "# Add labels and title\n",
        "plt.xlabel('School')\n",
        "plt.ylabel('Number of people')\n",
        "\n",
        "plt.xticks(rotation=0, ha='right')\n",
        "\n",
        "# Show the chart\n",
        "plt.show()\n"
      ],
